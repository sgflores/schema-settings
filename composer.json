{
    "name": "sgflores/schema-settings",
    "description": "A robust Laravel package for managing dynamic application and model-scoped settings with mandatory schema definition, validation, and type safety.",
    "keywords": [
        "laravel",
        "settings",
        "configuration",
        "dynamic-settings",
        "typed-settings",
        "schema",
        "preferences"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "sgflores",
            "email": "floresopic@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/validation": "^10.0|^11.0|^12.0",
        "illuminate/cache": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "SgFlores\\SchemaSetting\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SgFlores\\SchemaSetting\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SgFlores\\SchemaSetting\\SchemaSettingServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit --no-coverage"
    }
}
